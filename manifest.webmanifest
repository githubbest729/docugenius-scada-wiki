{
 "id": "com.algurg.docugenius.wiki",
 "name": "DocuGenius Wiki - SCADA Spec & Manual Vault",
 "short_name": "DocuGenius",
 "start_url": "./index.html",
 "scope": "./",
 "display": "standalone",
 "display_override": [
  "window-controls-overlay",
  "standalone",
  "minimal-ui"
 ],
 "background_color": "#0f172a",
 "theme_color": "#0f172a",
 "description": "Offline SCADA documentation vault for Al Gurg Automation and Controls.",
 "icons": [
  {
   "src": "icons/icon-72.png",
   "sizes": "72x72",
   "type": "image/png"
  },
  {
   "src": "icons/icon-96.png",
   "sizes": "96x96",
   "type": "image/png"
  },
  {
   "src": "icons/icon-128.png",
   "sizes": "128x128",
   "type": "image/png"
  },
  {
   "src": "icons/icon-144.png",
   "sizes": "144x144",
   "type": "image/png"
  },
  {
   "src": "icons/icon-152.png",
   "sizes": "152x152",
   "type": "image/png"
  },
  {
   "src": "icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icons/icon-384.png",
   "sizes": "384x384",
   "type": "image/png"
  },
  {
   "src": "icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icons/icon-maskable-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "icons/icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "shortcuts": [
  {
   "name": "New Spec Document",
   "short_name": "New Spec",
   "url": "./index.html?action=new-spec",
   "icons": [
    {
     "src": "icons/shortcut-new.png",
     "sizes": "96x96",
     "type": "image/png"
    }
   ]
  },
  {
   "name": "Import Tag List / IO Map",
   "short_name": "Import Tags",
   "url": "./index.html?action=import-tags",
   "icons": [
    {
     "src": "icons/shortcut-import.png",
     "sizes": "96x96",
     "type": "image/png"
    }
   ]
  },
  {
   "name": "Audit Trail & ECOs",
   "short_name": "Audit",
   "url": "./index.html?action=audit",
   "icons": [
    {
     "src": "icons/shortcut-audit.png",
     "sizes": "96x96",
     "type": "image/png"
    }
   ]
  }
 ],
 "screenshots": [
  {
   "src": "screenshots/screenshot-desktop.png",
   "sizes": "1280x720",
   "type": "image/png",
   "form_factor": "wide"
  },
  {
   "src": "screenshots/screenshot-mobile.png",
   "sizes": "750x1334",
   "type": "image/png",
   "form_factor": "narrow"
  }
 ],
 "file_handlers": [
  {
   "action": "./index.html?action=open-file",
   "name": "PLC tag list / vault",
   "accept": {
    "text/csv": [
     ".csv"
    ],
    "application/json": [
     ".json"
    ]
   },
   "launch_type": "single-client"
  }
 ],
 "launch_handler": {
  "client_mode": [
   "navigate-existing",
   "auto"
  ]
 }
}